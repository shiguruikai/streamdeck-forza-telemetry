{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Forza Telemetry",
  "Version": "0.1.0.0",
  "Author": "shiguruikai",
  "Actions": [
    {
      "UserTitleEnabled": false,
      "DisableCaching": true,
      "Name": "Speed Meter",
      "UUID": "com.github.shiguruikai.streamdeck-forza-telemetry.speed-meter",
      "Icon": "imgs/actions/speed-meter/icon",
      "Tooltip": "Show speed meter.",
      "PropertyInspectorPath": "ui/speed-meter.html",
      "Controllers": [ "Encoder" ],
      "Encoder": { "layout": "layouts/speed-meter-layout.json" },
      "States": [
        { "Image": "imgs/actions/speed-meter/key", "TitleAlignment": "middle" }
      ]
    },
    {
      "UserTitleEnabled": false,
      "DisableCaching": true,
      "Name": "Lap Time",
      "UUID": "com.github.shiguruikai.streamdeck-forza-telemetry.lap-time",
      "Icon": "imgs/actions/lap-time/icon",
      "Tooltip": "Show lap time.",
      "PropertyInspectorPath": "ui/lap-time.html",
      "Controllers": [ "Encoder" ],
      "Encoder": { "layout": "layouts/lap-time-layout.json" },
      "States": [
        { "Image": "imgs/actions/lap-time/key", "TitleAlignment": "middle" }
      ]
    },
    {
      "UserTitleEnabled": false,
      "DisableCaching": true,
      "Name": "G-Force Meter",
      "UUID": "com.github.shiguruikai.streamdeck-forza-telemetry.g-force",
      "Icon": "imgs/actions/g-force/icon",
      "Tooltip": "Show G-Force meter.",
      "PropertyInspectorPath": "ui/g-force.html",
      "Controllers": [ "Keypad", "Encoder" ],
      "Encoder": { "layout": "layouts/g-force-layout.json" },
      "States": [
        { "Image": "imgs/actions/g-force/key", "TitleAlignment": "middle" }
      ]
    },
    {
      "UserTitleEnabled": false,
      "DisableCaching": true,
      "Name": "Tire Temperature",
      "UUID": "com.github.shiguruikai.streamdeck-forza-telemetry.tire-temp",
      "Icon": "imgs/actions/tire-temp/icon",
      "Tooltip": "Show tire temperature.",
      "PropertyInspectorPath": "ui/tire-temp.html",
      "Controllers": [ "Keypad", "Encoder" ],
      "Encoder": { "layout": "layouts/tire-temp-layout.json" },
      "States": [
        { "Image": "imgs/actions/tire-temp/key", "TitleAlignment": "middle" }
      ]
    },
    {
      "UserTitleEnabled": false,
      "DisableCaching": true,
      "Name": "Suspension Travel",
      "UUID": "com.github.shiguruikai.streamdeck-forza-telemetry.suspension-travel",
      "Icon": "imgs/actions/suspension-travel/icon",
      "Tooltip": "Show normalized suspension travel.",
      "PropertyInspectorPath": "ui/suspension-travel.html",
      "Controllers": [ "Keypad", "Encoder" ],
      "Encoder": { "layout": "layouts/suspension-travel-layout.json" },
      "States": [
        { "Image": "imgs/actions/suspension-travel/key", "TitleAlignment": "middle" }
      ]
    }
  ],
  "Category": "Forza Telemetry",
  "CategoryIcon": "imgs/plugin/category-icon",
  "CodePath": "bin/plugin.js",
  "Description": "Displays Forza Horizon telemetry data on Stream Deck.",
  "Icon": "imgs/plugin/marketplace",
  "SDKVersion": 3,
  "Software": { "MinimumVersion": "7.1" },
  "OS": [
    { "Platform": "mac", "MinimumVersion": "12" },
    { "Platform": "windows", "MinimumVersion": "10" }
  ],
  "Nodejs": { "Version": "24", "Debug": "enabled" },
  "UUID": "com.github.shiguruikai.streamdeck-forza-telemetry"
}
