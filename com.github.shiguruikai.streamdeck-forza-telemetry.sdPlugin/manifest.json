{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Forza Telemetry",
  "Version": "1.0.0.0",
  "Author": "shiguruikai",
  "Actions": [
    {
      "UserTitleEnabled": true,
      "DisableCaching": true,
      "Name": "Speed Meter",
      "UUID": "com.github.shiguruikai.streamdeck-forza-telemetry.speed-meter",
      "Icon": "imgs/actions/speed-meter/icon",
      "Tooltip": "Show speed meter.",
      "PropertyInspectorPath": "ui/speed-meter.html",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/canvas-layout.json"
      },
      "States": [
        {
          "Image": "imgs/actions/speed-meter/key",
          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "UserTitleEnabled": true,
      "DisableCaching": true,
      "Name": "Race Info",
      "UUID": "com.github.shiguruikai.streamdeck-forza-telemetry.race-info",
      "Icon": "imgs/actions/race-info/icon",
      "Tooltip": "Show race information and lap times.",
      "PropertyInspectorPath": "ui/race-info.html",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/canvas-layout.json"
      },
      "States": [
        {
          "Image": "imgs/actions/race-info/key",
          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "UserTitleEnabled": true,
      "DisableCaching": true,
      "Name": "Tire Temperature",
      "UUID": "com.github.shiguruikai.streamdeck-forza-telemetry.tire-temp",
      "Icon": "imgs/actions/tire-temp/icon",
      "Tooltip": "Show tire temperature.",
      "PropertyInspectorPath": "ui/tire-temp.html",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/canvas-layout.json"
      },
      "States": [
        {
          "Image": "imgs/actions/tire-temp/key",
          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "UserTitleEnabled": true,
      "DisableCaching": true,
      "Name": "Suspension Travel",
      "UUID": "com.github.shiguruikai.streamdeck-forza-telemetry.suspension-travel",
      "Icon": "imgs/actions/suspension-travel/icon",
      "Tooltip": "Show normalized suspension travel.",
      "PropertyInspectorPath": "ui/suspension-travel.html",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/canvas-layout.json"
      },
      "States": [
        {
          "Image": "imgs/actions/suspension-travel/key",
          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "UserTitleEnabled": true,
      "DisableCaching": true,
      "Name": "G-Force Meter",
      "UUID": "com.github.shiguruikai.streamdeck-forza-telemetry.g-force",
      "Icon": "imgs/actions/g-force/icon",
      "Tooltip": "Show G-Force meter.",
      "PropertyInspectorPath": "ui/g-force.html",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/canvas-layout.json"
      },
      "States": [
        {
          "Image": "imgs/actions/g-force/key",
          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "UserTitleEnabled": true,
      "DisableCaching": true,
      "Name": "Compass",
      "UUID": "com.github.shiguruikai.streamdeck-forza-telemetry.compass",
      "Icon": "imgs/actions/compass/icon",
      "Tooltip": "Show compass.",
      "PropertyInspectorPath": "ui/compass.html",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/canvas-layout.json"
      },
      "States": [
        {
          "Image": "imgs/actions/compass/key",
          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "UserTitleEnabled": true,
      "DisableCaching": true,
      "Name": "Power & Torque",
      "UUID": "com.github.shiguruikai.streamdeck-forza-telemetry.power",
      "Icon": "imgs/actions/power/icon",
      "Tooltip": "Show engine power and torque.",
      "PropertyInspectorPath": "ui/power.html",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/canvas-layout.json"
      },
      "States": [
        {
          "Image": "imgs/actions/power/key",
          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "UserTitleEnabled": true,
      "DisableCaching": true,
      "Name": "Car Spec",
      "UUID": "com.github.shiguruikai.streamdeck-forza-telemetry.car-spec",
      "Icon": "imgs/actions/car-spec/icon",
      "Tooltip": "Show vehicle performance index, class, drivetrain, and cylinders.",
      "PropertyInspectorPath": "ui/car-spec.html",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/canvas-layout.json"
      },
      "States": [
        {
          "Image": "imgs/actions/car-spec/key",
          "TitleAlignment": "middle"
        }
      ]
    }
  ],
  "Category": "Forza Telemetry",
  "CategoryIcon": "imgs/plugin/category-icon",
  "CodePath": "bin/plugin.js",
  "Description": "Displays Forza Horizon and Forza Motorsport telemetry data on Stream Deck.",
  "Icon": "imgs/plugin/marketplace",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "24",
    "Debug": "enabled"
  },
  "UUID": "com.github.shiguruikai.streamdeck-forza-telemetry"
}