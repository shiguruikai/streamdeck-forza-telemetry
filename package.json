{
  "name": "streamdeck-forza-telemetry",
  "version": "0.1.0",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.github.shiguruikai.streamdeck-forza-telemetry\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "sim": "node tests/simulate-telemetry.ts",
    "sim:fh6": "node tests/simulate-telemetry.ts --format fh6",
    "sim:fm7": "node tests/simulate-telemetry.ts --format fm7-dash",
    "sim:fm8": "node tests/simulate-telemetry.ts --format fm8-dash",
    "sim:sled": "node tests/simulate-telemetry.ts --format fm-sled",
    "sd:validate": "streamdeck validate com.github.shiguruikai.streamdeck-forza-telemetry.sdPlugin",
    "sd:restart": "streamdeck restart com.github.shiguruikai.streamdeck-forza-telemetry",
    "sd:pack": "streamdeck pack -f com.github.shiguruikai.streamdeck-forza-telemetry.sdPlugin"
  },
  "type": "module",
  "devDependencies": {
    "@elgato/cli": "^1.7.4",
    "@elgato/utils": "^0.4.5",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@stylistic/eslint-plugin": "6.0.0-beta.5",
    "@tsconfig/node20": "^20.1.9",
    "@types/node": "~24.1.0",
    "eslint": "^10.7.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "rollup": "^4.62.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.0",
    "execa": "^9.6.1"
  },
  "engines": {
    "node": "^24"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11",
      "onFail": "download"
    }
  }
}
